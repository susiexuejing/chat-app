+// ============================================================
+// EM-45: 对话轮数管理
+// 用于维护每个 conversationId 的对话轮数
+// ============================================================
+
+interface ConversationTurnInfo {
+  turnCount: number;
+  lastActiveAt: number;  // 最后活跃时间，用于 TTL 清理
+}
+
+const conversationTurns = new Map<string, ConversationTurnInfo>();
+
+// conversationTurns 的 TTL：30 分钟（比 ChatSession 长，因为用户可能间隔较长）
+const CONVERSATION_TURN_TTL_MS = 30 * 60 * 1000;
+
+// 定期清理过期的 conversationTurns
+setInterval(() => {
+  const now = Date.now();
+  for (const [id, info] of conversationTurns) {
+    if (now - info.lastActiveAt > CONVERSATION_TURN_TTL_MS) {
+      conversationTurns.delete(id);
+      console.log(`[EM-45] Cleaned up expired conversationTurn: ${id}`);
+    }
+  }
+}, 60 * 1000); // 每分钟清理一次
+
+/**
+ * 获取或创建 conversationTurn 信息
+ * @param conversationId 对话 ID
+ * @returns 当前轮数信息
+ */
+function getOrCreateConversationTurn(conversationId: string): ConversationTurnInfo {
+  let info = conversationTurns.get(conversationId);
+  if (!info) {
+    info = { turnCount: 0, lastActiveAt: Date.now() };
+    conversationTurns.set(conversationId, info);
+    console.log(`[EM-45] Created new conversationTurn: ${conversationId}`);
+  }
+  return info;
+}
+
+/**
+ * 增加对话轮数并返回新的轮数
+ * @param conversationId 对话 ID
+ * @returns 新的轮数（从 1 开始）
+ */
+function incrementConversationTurn(conversationId: string): number {
+  const info = getOrCreateConversationTurn(conversationId);
+  info.turnCount += 1;
+  info.lastActiveAt = Date.now();
+  console.log(`[EM-45] Incremented turn for ${conversationId}: turnCount = ${info.turnCount}`);
+  return info.turnCount;
+}
+
+/**
+ * 获取当前对话轮数（不增加）
+ * @param conversationId 对话 ID
+ * @returns 当前轮数，如果不存在返回 0
+ */
+function getConversationTurn(conversationId: string): number {
+  const info = conversationTurns.get(conversationId);
+  return info ? info.turnCount : 0;
+}
+
