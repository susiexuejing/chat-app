# Runtime and user-derived data must never be committed.
# Keep only empty directory markers so runtime can initialize these paths.
server/data/ltu/*
!server/data/ltu/.gitkeep
server/data/evolution/*
!server/data/evolution/.gitkeep
server/data/neural_profiles.json
server/auto/data/*
!server/auto/data/.gitkeep
